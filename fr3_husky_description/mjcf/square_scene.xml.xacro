<?xml version="1.0" encoding="utf-8"?>
<mujoco xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="square_scene">
        <!-- Visual walls from robosuite PegsArena -->
        <!-- <geom pos="-1.2 0 1.5" quat="0.5 0.5 0.5 0.5"
              size="1.5 1.5 0.01" type="box" conaffinity="0" contype="0"
              group="1" name="wall_rear_visual" material="walls_mat"/> -->

        <!-- Table geometry from robosuite TableArena with NutAssembly dimensions -->
        <body name="table" pos="0.85 -0.25 0.6">
            <geom name="table_collision"
                  pos="0 0 0"
                  size="0.4 0.4 0.025"
                  type="box"
                  group="0"
                  friction="1 0.005 0.0001"/>
            <geom name="table_visual"
                  pos="0 0 0"
                  size="0.4 0.4 0.025"
                  type="box"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_ceramic"/>
            <site name="table_top" pos="0 0 0.025" size="0.001 0.001 0.001" rgba="0 0 0 0"/>

            <geom name="table_leg1_visual"
                  pos="0.3 0.3 -0.3975"
                  size="0.025 0.3975"
                  type="cylinder"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_legs_metal"/>
            <geom name="table_leg2_visual"
                  pos="-0.3 0.3 -0.3975"
                  size="0.025 0.3975"
                  type="cylinder"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_legs_metal"/>
            <geom name="table_leg3_visual"
                  pos="-0.3 -0.3 -0.3975"
                  size="0.025 0.3975"
                  type="cylinder"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_legs_metal"/>
            <geom name="table_leg4_visual"
                  pos="0.3 -0.3 -0.3975"
                  size="0.025 0.3975"
                  type="cylinder"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_legs_metal"/>
        </body>

        <!-- Fixed square-task peg -->
        <body name="peg1" pos="0.7 -0.25 0.65">
            <geom pos="0 0 0"
                  size="0.016 0.016 0.1"
                  type="box"
                  group="0"
                  friction="1 0.005 0.0001"/>
            <geom pos="0 0 0"
                  size="0.016 0.016 0.1"
                  type="box"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="bmetal"/>
        </body>

        <!-- Square nut from robosuite square-nut.xml -->
        <body name="obj" pos="0.7 -0.5 0.84" quat="0.7071 0 0 0.7071">
            <joint name="obj_joint" type="free" damping="0.0005"/>
            <geom pos="-0.03325 0 0"
                  size="0.0105 0.04375 0.01"
                  type="box"
                  solimp="0.998 0.998 0.001"
                  solref="0.02 1"
                  density="100"
                  friction="0.95 0.3 0.2"
                  group="0"
                  condim="4"
                  material="bmetal"/>
            <geom pos="0 0.03325 0"
                  size="0.03125 0.0105 0.01"
                  type="box"
                  solimp="0.998 0.998 0.001"
                  solref="0.02 1"
                  density="100"
                  friction="0.95 0.3 0.1"
                  group="0"
                  condim="4"
                  material="bmetal"/>
            <geom pos="0 -0.03325 0"
                  size="0.03125 0.0105 0.01"
                  type="box"
                  solimp="0.998 0.998 0.001"
                  solref="0.02 1"
                  density="100"
                  friction="0.95 0.3 0.1"
                  group="0"
                  condim="4"
                  material="bmetal"/>
            <geom pos="0.03325 0 0"
                  size="0.0105 0.04375 0.01"
                  type="box"
                  solimp="0.998 0.998 0.001"
                  solref="0.02 1"
                  density="100"
                  friction="0.95 0.3 0.1"
                  group="0"
                  condim="4"
                  material="bmetal"/>
            <geom pos="0.054 0 0"
                  size="0.02525 0.015875 0.01"
                  type="box"
                  solimp="0.998 0.998 0.001"
                  solref="0.02 1"
                  density="100"
                  friction="0.95 0.3 0.1"
                  group="0"
                  condim="4"
                  material="bmetal"/>
            <site name="obj_handle_site" rgba="1 0 0 1" size="0.005" pos="0.054 0 0"/>
            <site name="obj_center_site" rgba="1 0 0 1" size="0.003" pos="0 0 0"/>
            <site name="obj_bottom_site" rgba="0 0 0 0" size="0.005" pos="0 0 -0.05"/>
            <site name="obj_top_site" rgba="0 0 0 0" size="0.005" pos="0 0 0.01"/>
            <site name="obj_horizontal_radius_site" rgba="0 0 0 0" size="0.005" pos="0.11 0.06 0"/>
        </body>
    </xacro:macro>

</mujoco>
