<?xml version="1.0" encoding="utf-8"?>
<mujoco xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="coffee_scene">
        <!-- <geom pos="-1.2 0 1.5" quat="0.5 0.5 0.5 0.5"
              size="1.5 1.5 0.01" type="box" conaffinity="0" contype="0"
              group="1" name="wall_rear_visual" material="walls_mat"/> -->

        <!-- TableArena-style table with coffee task dimensions -->
        <body name="coffee_table" pos="0.8 -0.25 0.6">
            <geom name="coffee_table_collision"
                  pos="0 0 0"
                  size="0.4 0.6 0.025"
                  type="box"
                  group="0"
                  friction="1 0.005 0.0001"/>
            <geom name="coffee_table_visual"
                  pos="0 0 0"
                  size="0.4 0.6 0.025"
                  type="box"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_ceramic"/>
            <site name="coffee_table_top" pos="0 0 0.025" size="0.001 0.001 0.001" rgba="0 0 0 0"/>

            <geom name="coffee_table_leg1_visual"
                  pos="0.3 0.3 -0.3875"
                  size="0.025 0.3875"
                  type="cylinder"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_legs_metal"/>
            <geom name="coffee_table_leg2_visual"
                  pos="-0.3 0.3 -0.3875"
                  size="0.025 0.3875"
                  type="cylinder"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_legs_metal"/>
            <geom name="coffee_table_leg3_visual"
                  pos="-0.3 -0.3 -0.3875"
                  size="0.025 0.3875"
                  type="cylinder"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_legs_metal"/>
            <geom name="coffee_table_leg4_visual"
                  pos="0.3 -0.3 -0.3875"
                  size="0.025 0.3875"
                  type="cylinder"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_legs_metal"/>
        </body>

        <!-- Coffee machine, matching the CoffeeMachineObject composition in mimicgen -->
        <body name="coffee_machine_root" pos="0.8 -0.1 0.75" quat="0 0 0 1">
            <!-- <freejoint name="coffee_machine_joint"/> -->

            <body name="coffee_machine_body_root" pos="0 -0.05 0" quat="0 0 0 1">
                <geom name="coffee_machine_body_g0"
                      pos="0 0 0"
                      type="mesh"
                      mesh="coffee_body_mesh"
                      solimp="0.998 0.998 0.001"
                      solref="0.001 1"
                      density="1000"
                      friction="0.95 0.3 0.1"
                      group="0"
                      condim="4"
                      rgba="0.13 0.13 0.13 1"
                      material="ceramic"/>
            </body>

            <body name="coffee_machine_lid_main" pos="0 0.0385 0.144105" quat="0.5 0.8660254 0 0">
                <geom name="coffee_machine_lid_g0"
                      pos="0 0 0"
                      type="mesh"
                      mesh="coffee_lid_mesh"
                      solimp="0.998 0.998 0.001"
                      solref="0.001 1"
                      density="1000"
                      friction="0.95 0.3 0.1"
                      group="0"
                      condim="4"
                      rgba="0.839 0.839 0.839 1"
                      material="ceramic"/>
            </body>

            <body name="coffee_machine_base_root" pos="0 0.0 -0.1055" quat="0 0 0 1">
                <geom name="coffee_machine_base_g0"
                      pos="0 0 0"
                      type="mesh"
                      mesh="coffee_base_mesh"
                      solimp="0.998 0.998 0.001"
                      solref="0.001 1"
                      density="1000"
                      friction="0.95 0.3 0.1"
                      group="0"
                      condim="4"
                      rgba="0.13 0.13 0.13 1"
                      material="ceramic"/>
            </body>

            <body name="coffee_machine_pod_holder_holder_root" pos="0 0.06355 0.0865">
                <geom name="coffee_machine_pod_holder_holder_g0"
                      pos="0 0 0"
                      type="box"
                      size="0.01 0.01305 0.005"
                      rgba="0.839 0.839 0.839 1"
                      density="100"
                      friction="0.95 0.3 0.1"
                      solref="0.02 1"
                      solimp="0.998 0.998 0.001"/>
            </body>

            <body name="coffee_machine_pod_holder_root" pos="0 0.1061 0.0635">
                <geom name="coffee_machine_pod_holder_cup_body_g0"
                      pos="-0.025175 0 0"
                      axisangle="0 0 1 3.14159265"
                      type="box"
                      size="0.002078 0.01129 0.028"
                      rgba="1 0 0 1"
                      density="1000"
                      friction="0.95 0.3 0.1"
                      solref="0.02 1"
                      solimp="0.998 0.998 0.001"/>
                <geom name="coffee_machine_pod_holder_cup_body_g1"
                      pos="-0.017801 0.017801 0"
                      axisangle="0 0 1 2.35619449"
                      type="box"
                      size="0.002078 0.01129 0.028"
                      rgba="1 0 0 1"
                      density="1000"
                      friction="0.95 0.3 0.1"
                      solref="0.02 1"
                      solimp="0.998 0.998 0.001"/>
                <geom name="coffee_machine_pod_holder_cup_body_g2"
                      pos="0 0.025175 0"
                      axisangle="0 0 1 1.57079633"
                      type="box"
                      size="0.002078 0.01129 0.028"
                      rgba="1 0 0 1"
                      density="1000"
                      friction="0.95 0.3 0.1"
                      solref="0.02 1"
                      solimp="0.998 0.998 0.001"/>
                <geom name="coffee_machine_pod_holder_cup_body_g3"
                      pos="0.017801 0.017801 0"
                      axisangle="0 0 1 0.78539816"
                      type="box"
                      size="0.002078 0.01129 0.028"
                      rgba="1 0 0 1"
                      density="1000"
                      friction="0.95 0.3 0.1"
                      solref="0.02 1"
                      solimp="0.998 0.998 0.001"/>
                <geom name="coffee_machine_pod_holder_cup_body_g4"
                      pos="0.025175 0 0"
                      axisangle="0 0 1 0"
                      type="box"
                      size="0.002078 0.01129 0.028"
                      rgba="1 0 0 1"
                      density="1000"
                      friction="0.95 0.3 0.1"
                      solref="0.02 1"
                      solimp="0.998 0.998 0.001"/>
                <geom name="coffee_machine_pod_holder_cup_body_g5"
                      pos="0.017801 -0.017801 0"
                      axisangle="0 0 1 -0.78539816"
                      type="box"
                      size="0.002078 0.01129 0.028"
                      rgba="1 0 0 1"
                      density="1000"
                      friction="0.95 0.3 0.1"
                      solref="0.02 1"
                      solimp="0.998 0.998 0.001"/>
                <geom name="coffee_machine_pod_holder_cup_body_g6"
                      pos="0 -0.025175 0"
                      axisangle="0 0 1 -1.57079633"
                      type="box"
                      size="0.002078 0.01129 0.028"
                      rgba="1 0 0 1"
                      density="1000"
                      friction="0.95 0.3 0.1"
                      solref="0.02 1"
                      solimp="0.998 0.998 0.001"/>
                <geom name="coffee_machine_pod_holder_cup_body_g7"
                      pos="-0.017801 -0.017801 0"
                      axisangle="0 0 1 -2.35619449"
                      type="box"
                      size="0.002078 0.01129 0.028"
                      rgba="1 0 0 1"
                      density="1000"
                      friction="0.95 0.3 0.1"
                      solref="0.02 1"
                      solimp="0.998 0.998 0.001"/>
                <geom name="coffee_machine_pod_holder_cup_base_g0"
                      pos="0 0 -0.021"
                      type="cylinder"
                      size="0.025 0.005"
                      rgba="1 0 0 1"
                      density="1000"
                      friction="0.95 0.3 0.1"
                      solref="0.02 1"
                      solimp="0.998 0.998 0.001"/>
            </body>

            <!-- <body name="coffee_machine_cup_root" pos="0 0.1061 -0.0755" quat="0.7071068 0 0 -0.7071068">
                <geom name="coffee_machine_cup_body_g0"
                      pos="0 0 0"
                      type="cylinder"
                      size="0.03 0.025"
                      rgba="0.839 0.839 0.839 1"
                      density="1000"
                      friction="0.95 0.3 0.1"
                      solref="0.02 1"
                      solimp="0.998 0.998 0.001"/>
                <geom name="coffee_machine_cup_base_g0"
                      pos="0 0 -0.015"
                      type="cylinder"
                      size="0.025 0.005"
                      rgba="0.839 0.839 0.839 1"
                      density="1000"
                      friction="0.95 0.3 0.1"
                      solref="0.02 1"
                      solimp="0.998 0.998 0.001"/>
                <geom name="coffee_machine_cup_handle_g0"
                      type="capsule"
                      fromto="0 0.055 0 0 0.075 0"
                      size="0.003"
                      rgba="0.839 0.839 0.839 1"
                      density="1000"
                      friction="0.95 0.3 0.1"
                      solref="0.02 1"
                      solimp="0.998 0.998 0.001"/>
            </body> -->
        </body>

        <!-- Coffee pod, which is the manipulated object -->
        <body name="obj" pos="0.7 -0.4 0.7" quat="1 0 0 0"> <!-- z-axis : 1 0 0 0 | y-axis : NONE | x-axis : 1 0 0 0 -->
            <freejoint name="obj_joint"/>
            <geom name="coffee_pod_g0"
                  pos="0 0 0"
                  type="mesh"
                  mesh="coffee_pod_mesh"
                  solimp="0.998 0.998 0.001"
                  solref="0.001 1"
                  density="100"
                  friction="1 1 1"
                  group="0"
                  condim="4"
                  rgba="0.839 0.839 0.839 1"
                  material="ceramic"/>
            <site name="obj_bottom_site" rgba="0 0 0 0" size="0.005" pos="0 0 -0.023103"/>
            <site name="obj_top_site" rgba="0 0 0 0" size="0.005" pos="0 0 0.023103"/>
            <site name="obj_horizontal_radius_site" rgba="0 0 0 0" size="0.005" pos="0.0243 0.0243 0"/>
        </body>
    </xacro:macro>

</mujoco>
